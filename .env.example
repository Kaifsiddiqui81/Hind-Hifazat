# Hind Hifazat - Environment Variables

# ==========================================
# REQUIRED: Core Database & Security
# ==========================================
# Purpose: Primary connection string to your database.
# Source: Your database provider (e.g. Supabase, AWS RDS, local SQLite)
DATABASE_URL="file:./dev.db" 

# Purpose: Used to sign and verify JSON Web Tokens for user authentication.
# Source: Generate using `openssl rand -base64 32`
JWT_SECRET="replace-with-32-plus-byte-random-secret-from-openssl-rand-base64-32"

# Purpose: Hardcoded fallback token for admin dashboard access (until RBAC is implemented).
# Source: Generate using `openssl rand -base64 32`
ADMIN_TOKEN="replace-with-32-plus-byte-random-admin-token"

# ==========================================
# OPTIONAL: Communication Providers
# ==========================================
# Purpose: Twilio credentials for sending SMS OTPs and alerts.
# Source: Twilio Console Dashboard
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE_NUMBER="your-twilio-phone"

# Purpose: API key for WhatsApp Business integration (for dispatching WhatsApp alerts).
# Source: Your WhatsApp BSP (e.g., Gupshup, Twilio, Meta)
WHATSAPP_PROVIDER_KEY="your-whatsapp-provider-key"

# Purpose: VAPID keys for browser push notifications.
# Source: Generate via web-push library (`npx web-push generate-vapid-keys`)
WEB_PUSH_PUBLIC_KEY="your-web-push-public-key"
WEB_PUSH_PRIVATE_KEY="your-web-push-private-key"

# ==========================================
# OPTIONAL: Third-Party APIs
# ==========================================
# Purpose: Used by AIAssistant for triage and parsing incident situations.
# Source: Google AI Studio
GEMINI_API_KEY="your-gemini-api-key"

# Purpose: For global area autocomplete and exact coordinate geocoding.
# Source: Google Cloud Console (Maps JavaScript API & Places API enabled)
GOOGLE_MAPS_API_KEY="optional-google-places-key-for-global-area-autocomplete"

# Purpose: API key for sending offline SOS via supported satellite hardware.
# Source: Your hardware provider's developer console
SATELLITE_PROVIDER_API_KEY="optional-supported-hardware-provider-key"

